# --- Servidor MCP (python -m mcps.brasaland_mcp) ---------------------------------------------------------------
# URL pública del endpoint MCP. Es el "resource" OAuth: debe coincidir con el Identifier de la API en Auth0.
# En Codespaces: https://<nombre-del-codespace>-8001.app.github.dev/mcp   (puerto 8001 en visibilidad Public)
MCP_PUBLIC_URL=https://TU-CODESPACE-8001.app.github.dev/mcp
# Emisor OIDC (Auth0): https://<tenant>.<region>.auth0.com/   (con la barra final)
OAUTH_ISSUER=https://TU-TENANT.eu.auth0.com/
# Audience esperada en el JWT (por defecto, MCP_PUBLIC_URL)
OAUTH_AUDIENCE=https://TU-CODESPACE-8001.app.github.dev/mcp
# Hosts permitidos en la cabecera Host (protección DNS-rebinding), separados por comas
MCP_ALLOWED_HOSTS=TU-CODESPACE-8001.app.github.dev
# Backend propio (services/api) y cuenta de servicio con la que el MCP hace login
MCP_BACKEND_BASE_URL=http://localhost:8000
MCP_BACKEND_EMAIL=mcp@brasaland.test
MCP_BACKEND_PASSWORD=cambia-esto
# Log de auditoría (JSONL)
MCP_AUDIT_LOG=data/logs/mcp-audit.jsonl

# --- Agente LangGraph (cliente MCP) -----------------------------------------------------------------------------
MCP_SERVER_URL=https://TU-CODESPACE-8001.app.github.dev/mcp
AGENT_MCP_TOKEN_URL=https://TU-TENANT.eu.auth0.com/oauth/token
AGENT_MCP_CLIENT_ID=
AGENT_MCP_CLIENT_SECRET=
# AGENT_MCP_AUDIENCE=   (por defecto, MCP_SERVER_URL)
# AGENT_MCP_SCOPES="tickets:read inventory:read"   (el agente solo pide lectura)
