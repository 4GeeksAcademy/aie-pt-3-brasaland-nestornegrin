# Copia este archivo a .env y rellena los valores reales.
# .env nunca se sube al repo (ver .gitignore) — las API keys viven solo aquí.

# JWT de sesión
JWT_SECRET_KEY=cambia-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Restablecimiento de contraseña (AUTH-03)
# Token de un solo uso enviado por email; ventana recomendada 15-60 minutos.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Resend (https://resend.com) — API key de tu cuenta.
# Con el remitente de pruebas "onboarding@resend.dev" solo puedes enviar al
# email con el que te registraste en Resend, sin verificar un dominio propio.
RESEND_API_KEY=re_tu_api_key
EMAIL_FROM=Brasaland <onboarding@resend.dev>

# URL pública del frontend (uis/backoffice) usada para construir el enlace
# de restablecimiento: {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:3001
