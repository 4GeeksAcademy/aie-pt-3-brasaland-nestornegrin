# Copia este archivo a .env y rellena los valores reales.
# .env nunca se sube al repo (ver .gitignore) — las API keys viven solo aquí.

# JWT de sesión
JWT_SECRET_KEY=cambia-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Restablecimiento de contraseña (AUTH-03)
# Token de un solo uso enviado por email; ventana recomendada 15-60 minutos.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Resend (https://resend.com) — API key de tu cuenta.
# Con el remitente de pruebas "onboarding@resend.dev" solo puedes enviar al
# email con el que te registraste en Resend, sin verificar un dominio propio.
RESEND_API_KEY=re_tu_api_key
EMAIL_FROM=Brasaland <onboarding@resend.dev>

# URL pública del frontend (uis/backoffice) usada para construir el enlace
# de restablecimiento: {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:3001

# RAG / base de conocimiento (Hito 7). Estas variables van en el .env de la RAÍZ del repo.
# Qdrant Cloud (https://cloud.qdrant.io): URL del clúster (con :6333) y clave de API.
QDRANT_URL=https://tu-cluster.region.cloud.qdrant.io:6333
QDRANT_API_KEY=tu_clave_de_qdrant
# Modelos proporcionados por 4Geeks (endpoint compatible con la API de OpenAI). Cada equipo tiene su propia lista de
# modelos permitidos: si pides otro, el servidor responde 403 y te dice cuáles puedes usar.
LLM_API_KEY=tu_clave_del_llm
LLM_API_URL=https://llm.4geeks.ai
EMBEDDING_MODEL=id-del-modelo-de-embeddings
GENERATION_MODEL=id-del-modelo-de-chat
# Opcional: umbral mínimo de similitud (si no, se usa el calibrado en data/process/rag_config.py).
# RAG_MIN_SCORE=0.45

# Telemetría: URL del endpoint POST /telemetry/events (el frontend usa NEXT_PUBLIC_TELEMETRY_ENDPOINT).
# La tabla telemetry_events se crea con services/api/migrations/001_create_telemetry_events.sql.
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
# Cadena de conexión a Supabase/Postgres (inventario, SQLModel).
DATABASE_URL=postgresql://usuario:contraseña@host.supabase.co:5432/postgres

# Autenticación federada (Google) — ver docs/security/federated-auth.md
# Crea las credenciales en Google Cloud Console (OAuth 2.0 · aplicación web) y añade OAUTH_REDIRECT_URI como "URI de redireccionamiento".
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback/google
# Otros redirect_uri permitidos (coincidencia EXACTA), separados por coma. Útil en Codespaces: https://<codespace>-3000.app.github.dev/auth/callback/google
# OAUTH_ALLOWED_REDIRECT_URIS=
# En las tablets compartidas de los locales: FEDERATED_AUTH_ENABLED=false (no se ofrece login con Google).
# FEDERATED_AUTH_ENABLED=true

# --- Audit log (app/audit): clave que firma la cadena de hash (HMAC-SHA256).
# En producción define una clave PROPIA y larga (distinta de JWT_SECRET_KEY) y guárdala fuera del servidor de datos.
# Si no se define, se deriva de JWT_SECRET_KEY. Cambiarla invalida la verificación de las entradas anteriores.
# AUDIT_CHAIN_KEY=
