# Copia este archivo a .env y rellena los valores reales.
# .env nunca se sube al repo (ver .gitignore) — las API keys viven solo aquí.

# JWT de sesión
JWT_SECRET_KEY=cambia-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Restablecimiento de contraseña (AUTH-03)
# Token de un solo uso enviado por email; ventana recomendada 15-60 minutos.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Resend (https://resend.com) — API key de tu cuenta.
# Con el remitente de pruebas "onboarding@resend.dev" solo puedes enviar al
# email con el que te registraste en Resend, sin verificar un dominio propio.
RESEND_API_KEY=re_tu_api_key
EMAIL_FROM=Brasaland <onboarding@resend.dev>

# URL pública del frontend (uis/backoffice) usada para construir el enlace
# de restablecimiento: {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:3001

# RAG / base de conocimiento (Hito 7). Estas variables van en el .env de la RAÍZ del repo.
# Qdrant Cloud (https://cloud.qdrant.io): URL del clúster (con :6333) y clave de API.
QDRANT_URL=https://tu-cluster.region.cloud.qdrant.io:6333
QDRANT_API_KEY=tu_clave_de_qdrant
# Modelos proporcionados por 4Geeks (endpoint compatible con la API de OpenAI). La clave es obligatoria; la URL y
# los IDs de modelo son opcionales (por defecto: OpenAI, text-embedding-3-small y gpt-4o-mini, los del tutorial).
LLM_API_KEY=tu_clave_del_llm
# LLM_API_URL=https://url-base-del-proveedor/v1
# EMBEDDING_MODEL=text-embedding-3-small
# GENERATION_MODEL=gpt-4o-mini
# Opcional: umbral mínimo de similitud (si no, se usa el calibrado en data/process/rag_config.py).
# RAG_MIN_SCORE=0.30
