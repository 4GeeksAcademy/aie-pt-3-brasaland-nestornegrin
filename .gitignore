__pycache__/
*.egg-info/
.coverage
.venv/

# Trazas de ejecución del agente (se generan en cada corrida)
data/traces/

# Log de auditoría del servidor MCP (una línea JSON por invocación de tool)
data/logs/
data/memory/

# RFPs subidos en runtime (Hito 9)
data/raw/rfp/

# Checkpoints de la aprobación humana (Hito 9 · Parte 3): estado de runtime, no código
data/runtime/

# Secretos (NIST Protect / OWASP A02): el .env de la raíz guarda LLM_API_KEY, QDRANT_API_KEY y credenciales OAuth.
# Solo se versionan las plantillas *.env.example, sin valores reales.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Salida generada en cada corrida del pipeline de desempeño de negocio (data/pipelines/pipeline.py)
data/eval/inventory_performance_last_run.json
data/eval/*.tmp

# Respaldo diario de telemetría que genera scripts/nightly_export.py (datos de usuarios: no se versionan)
data/raw/telemetry_*.csv
data/raw/telemetry_*.csv.tmp
