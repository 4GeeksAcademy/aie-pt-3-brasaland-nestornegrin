# Copia este archivo a .env (en la raíz) y rellena los valores reales antes
# de correr `docker compose up`. Nunca se sube al repo (ver .gitignore).

# ------------------------------------------------------------------
# Backend (services/api)
# ------------------------------------------------------------------
JWT_SECRET_KEY=cambia-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Resend (https://resend.com) — API key de tu cuenta.
RESEND_API_KEY=re_tu_api_key
EMAIL_FROM=Brasaland <onboarding@resend.dev>

# URL pública del backoffice, usada por el backend para construir el
# enlace de restablecimiento de contraseña que se envía por email. Es la
# URL que abre un humano en su navegador (puerto publicado en el host),
# no un nombre de servicio Docker.
FRONTEND_URL=http://localhost:3001

# Cadena de conexión a Supabase/Postgres (inventario, SQLModel). Es un
# servicio externo en la nube, no un contenedor de este docker-compose.
DATABASE_URL=postgresql://usuario:contraseña@host.supabase.co:5432/postgres

# Cola de tareas asíncronas (Celery + Redis, DEV-55). docker-compose.yml ya fija
# REDIS_URL=redis://redis:6379/0 para los contenedores; esta variable es para correr
# la API o el worker FUERA de Docker (Redis en localhost, p. ej. `docker compose up redis`).
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# Frontend (uis/backoffice)
# ------------------------------------------------------------------
# NEXT_PUBLIC_* se incrusta en el código que corre en el NAVEGADOR, no
# dentro del contenedor -- por eso apunta al puerto publicado en el host
# (localhost:8000) y no al nombre del servicio Docker "api". El navegador
# nunca puede resolver nombres de servicio de la red interna de Docker;
# solo el tráfico contenedor-a-contenedor usaría ese nombre, y en este
# proyecto no existe ninguna llamada de ese tipo (todo el fetch al backend
# ocurre desde componentes de cliente en el navegador).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000
